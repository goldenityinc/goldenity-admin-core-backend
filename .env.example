# ===== Goldenity Admin Core Backend (Production / Railway) =====
# Salin file ini menjadi .env di direktori ini (jangan commit .env asli)

# ---- Server ----
# PORT otomatis di-inject Railway. Default lokal 5001.
PORT=5001
NODE_ENV=production

# ---- Database Postgres (Railway Auto-inject DATABASE_URL) ----
# DATABASE_URL di Railway otomatis tersedia dari Postgres plugin.
# Contoh format (jika setting manual):
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?schema=public&pgbouncer=true"
DATABASE_URL=""

# Direct database connection optional (untuk prisma migrate yang butuh direct)
DIRECT_URL=""

# ---- Auth: Firebase Admin SDK (Multi-tenant Auth + POS Web Token) ----
# OPSIONAL (jika pakai FIREBASE_SERVICE_ACC base64 dibawah):
# FIREBASE_SERVICE_ACC adalah output `base64 service-account-key.json`
# Contoh generate: `cat ./service-account-key.json | base64 -w0` (Linux) | `base64 < file` (Mac)
FIREBASE_SERVICE_ACC=""

# Jika ingin langsung pakai path file (opsional untuk dev):
# GOOGLE_APPLICATION_CREDENTIALS="./service-account-key.json"

# ---- JWT Super Admin (generate: openssl rand -hex 32) ----
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# ---- CORS Origins (tambahkan frontend production Railway disini) ----
# Pisahkan banyak origin dengan koma.
ALLOWED_ORIGINS="https://goldenity-super-admin.up.railway.app,https://goldenity-super-admin.vercel.app"

# URL Production Frontend
FRONTEND_URL="https://goldenity-super-admin.up.railway.app"
POS_URL=""

# ===== Storage Uploads =====
# === PILIHAN A: RAILWAY VOLUME / LOCAL FALLBACK (default tanpa S3) ===
# Tidak perlu set S3 env — file akan tersimpan di ./public/uploads/
# Pastikan mount Volume di Railway service dengan mountPath: /app/public/uploads
# Supaya file bukti transaksi & nota tidak hilang saat redeploy.

# === PILIHAN B: RAILWAY S3 COMPATIBLE (Cloudflare R2 via Railway Storage) ===
# DASHBOARD RAILWAY > Backend Service > STORAGE > "Add Storage" -> Pilih "S3 Compatible"
# Setelah dibuat, copy-paste Values berikut dari Railway Storage Settings:
S3_BUCKET_NAME=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
S3_ENDPOINT="https://<YOUR-S3-ENDPOINT>.r2.cloudflarestorage.com"

# Alternative key names (jika Anda pakai AWS native):
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_BUCKET_NAME=""
# AWS_REGION="ap-southeast-1"
# AWS_ENDPOINT="https://s3.ap-southeast-1.amazonaws.com"

# ---- Seed Admin Default (first time provisioning) ----
SUPERADMIN_EMAIL="superadmin@goldenity.id"
SUPERADMIN_PASSWORD=""
SUPERADMIN_FULL_NAME="Super Admin Goldenity"

# ---- Debug / Feature Flag ----
DEBUG_ACCOUNTING=""
LOG_QUERIES=""
